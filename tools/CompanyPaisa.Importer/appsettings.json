{
  "Logging": {
    "LogLevel": { "Default": "Information", "System.Net.Http": "Warning", "Microsoft": "Warning" }
  },
  "Importer": {
    "Sec": {
      "UserAgent": "CompanyPaisa your-email@example.com",
      "MaxRequestsPerSecond": 8,
      "CacheDirectory": "data/cache/sec",
      "IndexCacheHours": 24
    },
    "Discovery": {
      "State": "UT",
      "Forms": [ "10-K" ],
      "FiledSince": "2024-06-01"
    },
    "Region": {
      "Name": "Wasatch Front",
      "Anchors": [
        { "Name": "Ogden", "Latitude": 41.2230, "Longitude": -111.9738, "RadiusMiles": 14 },
        { "Name": "Salt Lake City", "Latitude": 40.7608, "Longitude": -111.8910, "RadiusMiles": 22 },
        { "Name": "Lehi / Silicon Slopes", "Latitude": 40.3916, "Longitude": -111.8508, "RadiusMiles": 14 },
        { "Name": "Provo", "Latitude": 40.2338, "Longitude": -111.6585, "RadiusMiles": 18 }
      ]
    },
    "Listing": {
      "Exchanges": [ "Nasdaq", "NYSE", "CBOE" ],
      "MinOtcRevenue": 5000000,
      "IncludeUnlisted": false
    },
    "History": {
      "Years": 10,
      "MaxProxiesPerCompany": 5
    },
    "Geo": {
      "GazetteerUrl": "https://www2.census.gov/geo/docs/maps-data/data/gazetteer/2025_Gazetteer/2025_Gaz_zcta_national.zip",
      "ZipPrefixes": [ "84" ],
      "ZipTableOutput": "data/reference/ut-zip-centroids.csv",
      "ZipNamesSeed": "data/reference/us-zip-centroids.sample.csv"
    },
    "Output": {
      "WorkbookPath": "data/companypaisa.xlsx",
      "ReportPath": "data/import-report.md"
    },
    "CuratedOfficesPath": "data/curated/utah-offices.csv"
  }
}
