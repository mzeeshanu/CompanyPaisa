{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "DataSource": {
    "Excel": {
      "Path": "data/companypaisa.xlsx",
      "AdditionalPaths": [ "data/companypaisa-uk.xlsx" ]
    }
  },

  "Geo": {
    "ZipTablePath": "data/reference/us-zip-centroids.csv",
    "AdditionalTablePaths": [ "data/reference/uk-postcode-districts.csv", "data/reference/ca-postal-areas.csv" ]
  },

  "Hosting": {
    "TrustForwardedHeaders": true,
    "UseHttpsRedirection": true
  }
}
