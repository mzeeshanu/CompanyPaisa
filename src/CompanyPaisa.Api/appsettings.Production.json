{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "DataSource": {
    "Sqlite": { "Path": "data/companypaisa.db" }
  },

  "Geo": {
    "ZipTablePath": "data/reference/us-zip-centroids.csv",
    "AdditionalTablePaths": [ "data/reference/uk-postcode-districts.csv", "data/reference/ca-postal-areas.csv", "data/reference/eu-postcodes.csv", "data/reference/anz-postcodes.csv", "data/reference/pk-postcodes.csv" ]
  },

  "Api": {
    "//": "companypaisa.com is served through Cloudflare, which puts each visitor's own IP in this header.",
    "ClientIpHeader": "CF-Connecting-IP"
  },

  "Analytics": {
    "//": "Railway variables: Analytics__ConnectionString = ${{Postgres.DATABASE_URL}}, Analytics__DashboardKey = a long random secret. Without a connection string nothing is recorded.",
    "Provider": "Postgres"
  },

  "Hosting": {
    "TrustForwardedHeaders": true,
    "UseHttpsRedirection": true
  }
}
