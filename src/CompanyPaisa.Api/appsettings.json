{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DataSource": {
    "Provider": "Excel",
    "ConnectionString": "",
    "Excel": {
      "Path": "../../data/companypaisa.xlsx",
      "ReloadOnChange": true,
      "ReloadDebounceMs": 1500,
      "Sheets": {
        "Companies": "Companies",
        "Locations": "Locations",
        "Financials": "Financials",
        "ExecutiveCompensation": "ExecutiveCompensation",
        "Meta": "_meta"
      }
    }
  },

  "Geo": {
    "ZipTablePath": "../../data/reference/ut-zip-centroids.csv"
  },

  "Search": {
    "DefaultRadiusMiles": 10,
    "AllowedRadiiMiles": [ 5, 10, 25, 50 ],
    "MaxRadiusMiles": 100,
    "DefaultSort": "Revenue",
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "CoverageMiles": 60
  },

  "Metrics": {
    "TrendUpThresholdPct": 4,
    "TrendDownThresholdPct": -1,
    "LossMakingIsDown": true,
    "CagrYears": 5,
    "HistoryYears": 10
  },

  "Caching": {
    "Enabled": true,
    "MaxEntries": 10000,
    "Profiles": {
      "Search": 3600,
      "Company": 86400,
      "Reference": 86400
    }
  },

  "Pipeline": {
    "SlowRequestThresholdMs": 500
  },

  "Api": {
    "AllowAnonymous": true,
    "ApiKeyHeader": "X-Api-Key",
    "Keys": [],
    "RateLimits": {
      "AnonymousPerMinute": 120,
      "KeyedPerMinute": 1200
    },
    "CorsAllowedOrigins": [],
    "EnableOpenApi": true,
    "EnableSwaggerUi": true
  },

  "Ui": {
    "DefaultView": "List",
    "DefaultTheme": "Auto",
    "Map": {
      "ShowBaseMapByDefault": true,
      "TilesUrl": null
    },
    "Consent": {
      "CookieName": "cp_prefs",
      "CookieDays": 365
    }
  },

  "Features": {
    "MapView": true,
    "ListView": true,
    "Executives": true
  }
}
