{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DataSource": {
    "Provider": "Excel",
    "ConnectionString": "",
    "Excel": {
      "Path": "../../data/companypaisa.xlsx",
      "AdditionalPaths": [ "../../data/companypaisa-uk.xlsx", "../../data/companypaisa-eu.xlsx" ],
      "ReloadOnChange": true,
      "ReloadDebounceMs": 1500,
      "Sheets": {
        "Companies": "Companies",
        "Locations": "Locations",
        "Financials": "Financials",
        "ExecutiveCompensation": "ExecutiveCompensation",
        "Meta": "_meta"
      }
    }
  },

  "Geo": {
    "ZipTablePath": "../../data/reference/us-zip-centroids.csv",
    "AdditionalTablePaths": [ "../../data/reference/uk-postcode-districts.csv", "../../data/reference/ca-postal-areas.csv", "../../data/reference/eu-postcodes.csv" ]
  },

  "Currency": {
    "//": "Approximate rates (US dollars per unit), only for adding up and ranking amounts in different currencies. Figures are always shown as reported.",
    "UsdPer": { "USD": 1.0, "GBP": 1.27, "EUR": 1.08, "CAD": 0.73 }
  },

  "Search": {
    "DefaultRadiusMiles": 10,
    "AllowedRadiiMiles": [ 5, 10, 25, 50 ],
    "MaxRadiusMiles": 100,
    "DefaultSort": "Revenue",
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "CoverageMiles": 60
  },

  "Metrics": {
    "TrendUpThresholdPct": 4,
    "TrendDownThresholdPct": -1,
    "LossMakingIsDown": true,
    "CagrYears": 5,
    "HistoryYears": 10
  },

  "Caching": {
    "Enabled": true,
    "MaxEntries": 10000,
    "Profiles": {
      "Search": 3600,
      "Company": 86400,
      "Reference": 86400
    }
  },

  "Pipeline": {
    "SlowRequestThresholdMs": 500
  },

  "Api": {
    "AllowAnonymous": true,
    "ApiKeyHeader": "X-Api-Key",
    "Keys": [],
    "RateLimits": {
      "AnonymousPerMinute": 120,
      "KeyedPerMinute": 1200
    },
    "CorsAllowedOrigins": [],
    "EnableOpenApi": true,
    "EnableSwaggerUi": true
  },

  "Ui": {
    "DefaultView": "List",
    "DefaultTheme": "Auto",
    "Map": {
      "ShowBaseMapByDefault": true,
      "TilesUrl": null
    },
    "Consent": {
      "CookieName": "cp_prefs",
      "CookieDays": 365
    },
